# ENV='prod'
ENV='dev'
SECRET_KEY=''
DEBUG='True'

APP_HOST='0.0.0.0'
APP_PORT=3100
APP_ROOT=''
APP_PATH=''

DB_USERNAME=''
DB_PASSWORD=''
DB_HOST=''
DB_NAME=''
DB_PORT=

MOBILE_APP_PATH=''

MAIL_API_KEY=''
MAIL_DEFAULT_SENDER=''

BASE_URL='http://127.0.0.1:3100'

# BellBank's docs describe no webhook signature, and their API security is
# IP allowlisting. Set the addresses they send webhooks from (comma
# separated) -- ask BellBank for the list. The webhook rejects every
# request unless this or BELLBANK_WEBHOOK_SECRET is configured.
BELLBANK_WEBHOOK_IPS=''
# Static-IP proxy for outbound BellBank calls (http://user:password@host:port).
# BellBank whitelists the proxy's IPs. Empty sends calls directly.
BELLBANK_PROXY_URL=''

# Identity provider for checking name, date of birth and gender against the
# BVN at the KYC step. Unset means no verification happens and KYC accepts
# whatever the customer typed. Set these before real customers: BellBank
# cannot correct a client created with wrong details, only delete it.
DOJAH_APP_ID=''
DOJAH_SECRET_KEY=''
DOJAH_BASE_URL='https://api.dojah.io'
