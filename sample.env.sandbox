# Sandbox profile: test deposits and transfers against BellBank's sandbox,
# with no live money. Copy to .env.sandbox (gitignored), fill in the test
# keys, and start the app with ENV_FILE=.env.sandbox. Anything not set here
# comes from .env. See docs/SANDBOX.md.

# Refuses to start unless BELLBANK_BASEURL below is a sandbox url.
BELLBANK_SANDBOX=true
BELLBANK_BASEURL=https://sandbox-baas-api.bellmonie.com

# BellBank portal -> Settings -> API Configuration -> Test mode.
# These are NOT the live keys in .env.
BELLBANK_CONSUMER_KEY=''
BELLBANK_CONSUMER_SECRET=''

# The sandbox does not check IPs, so no proxy (and no Fixie requests used).
BELLBANK_PROXY_URL=''

# 127.0.0.1 lets scripts/simulate_bellbank_deposit.py credit a local wallet.
# Add the sandbox's own address when it posts through a tunnel; the
# rejection log prints it.
BELLBANK_WEBHOOK_IPS='127.0.0.1'

# A separate local database, so test customers never mix with real data.
# Create it once:  createdb -h localhost -p 5433 -U postgres payverve_sandbox
DATABASE_URL=postgresql://postgres@localhost:5433/payverve_sandbox

ENV=dev
APP_PORT=10000
